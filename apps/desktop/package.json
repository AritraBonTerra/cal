{
  "name": "@cal/desktop",
  "productName": "Cal",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bun scripts/prepare.ts && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "bun scripts/prepare.ts && electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc -p . && tsc -p scripts",
    "prepare:dev": "bun scripts/prepare.ts",
    "screenshots": "bun scripts/screenshot.ts"
  },
  "dependencies": {
    "@cal/app-core": "workspace:*",
    "@cal/backend": "workspace:*",
    "@cal/calendar-source": "workspace:*",
    "@cal/domain": "workspace:*",
    "@cal/nlp": "workspace:*",
    "@cal/sync": "workspace:*",
    "convex": "1.48.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
