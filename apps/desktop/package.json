{
  "name": "@cal/desktop",
  "productName": "Cal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bun scripts/prepare.ts && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "bun scripts/prepare.ts && electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc -p . && tsc -p scripts && tsc -p tests",
    "prepare:dev": "bun scripts/prepare.ts",
    "screenshots": "bun scripts/screenshot.ts",
    "smoke": "bun scripts/smoke.ts",
    "test": "TZ=America/Los_Angeles bun test",
    "dist": "bun scripts/prepare.ts && env -u ELECTRON_RUN_AS_NODE electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@better-auth/electron": "1.6.33",
    "@cal/app-core": "workspace:*",
    "@cal/backend": "workspace:*",
    "@cal/calendar-source": "workspace:*",
    "@cal/domain": "workspace:*",
    "@cal/fixtures": "workspace:*",
    "@cal/nlp": "workspace:*",
    "@cal/sync": "workspace:*",
    "@cal/theme": "workspace:*",
    "@convex-dev/better-auth": "0.12.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "better-auth": "1.6.33",
    "convex": "1.48.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.63.0",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "description": "Keyboard-first calendar, tasks and time-blocking",
  "author": "Aritra Das"
}
